# Server
PORT=5050
NODE_ENV=development

# PostgreSQL connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/bws_sports?schema=public"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Website and dashboard addresses (used in password reset links). CORS allows every address.
CLIENT_URL="http://localhost:5173"
DASHBOARD_URL="http://localhost:5174"

# Email (optional). Leave SMTP_HOST empty in development: reset links are printed in the server console.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="BWS Sports <no-reply@bwssports.com>"

# Seeded admin account
ADMIN_EMAIL="admin@bwssports.com"
ADMIN_PASSWORD="Admin@123"
